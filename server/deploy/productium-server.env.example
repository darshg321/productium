# /etc/productium-server.env
PRODUCTIUM_SERVER_HOST=127.0.0.1
PRODUCTIUM_SERVER_PORT=8790
PRODUCTIUM_SERVER_DATA=/var/lib/productium-server
# claude-server, which checks the keys backups are filed under
PRODUCTIUM_SERVER_UPSTREAM=http://127.0.0.1:8787
PRODUCTIUM_SERVER_MAX_BACKUP=41943040
PRODUCTIUM_SERVER_BACKUPS_KEPT=6
